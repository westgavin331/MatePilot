# Onshape API keys (My account > API keys). Never commit the real .env file.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE=https://cad.onshape.com
PORT=3000
# Safety switch: mates are only really created when this is "true".
# While false, "yes" in the panel shows what WOULD be sent, without sending it.
MATEPILOT_ALLOW_WRITES=false
# Hard lock: comma-separated document ids MatePilot may change. Empty = none.
MATEPILOT_WRITE_DOCS=
# Optional: paths to a certificate if the Onshape panel needs https.
HTTPS_KEY=
HTTPS_CERT=
