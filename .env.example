# Onshape API keys (My account > API keys). Never commit the real .env file.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_BASE=https://cad.onshape.com
PORT=3000
# How MatePilot signs in to Onshape: "apikey" (the keys above) or "oauth" (browser login).
ONSHAPE_AUTH_MODE=apikey
# OAuth app (Onshape Developer Portal). Redirect URL registered there must match below.
ONSHAPE_OAUTH_CLIENT_ID=
ONSHAPE_OAUTH_CLIENT_SECRET=
ONSHAPE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# Encrypts the login cookie. Required when hosted (Render): long random text, never shared.
# Locally it may stay empty (then a restart logs you out).
SESSION_SECRET=
# Safety switch: mates are only really created when this is "true".
# While false, "yes" in the panel shows what WOULD be sent, without sending it.
MATEPILOT_ALLOW_WRITES=false
# Hard lock: comma-separated document ids MatePilot may change. Empty = none.
MATEPILOT_WRITE_DOCS=
# Optional: paths to a certificate if the Onshape panel needs https.
HTTPS_KEY=
HTTPS_CERT=
